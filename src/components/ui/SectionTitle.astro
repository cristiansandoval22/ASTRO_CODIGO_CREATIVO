---
/* ==========================================================
   SECTION TITLE — encabezado que usan todas las secciones

   Uso:
   <SectionTitle etiqueta="Servicios" titulo="Lo que hacemos" descripcion="..." />
   La descripción es opcional.
   ========================================================== */

const { etiqueta, titulo, descripcion } = Astro.props;
---

<header class="section-title">
  <p class="section-title__etiqueta">{etiqueta}</p>
  <h2 class="section-title__titulo">{titulo}</h2>
  {descripcion && <p class="section-title__descripcion">{descripcion}</p>}
</header>

<style>
  .section-title {
    max-width: 640px;
    margin: 0 auto var(--espacio-xl); /* centrado + espacio abajo */
    text-align: center;
  }

  .section-title__etiqueta {
    margin-bottom: var(--espacio-xs);
    font-family: var(--fuente-titulos);
    font-size: var(--texto-sm);
    font-weight: var(--peso-bold);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primario);
  }

  .section-title__titulo {
    margin-bottom: var(--espacio-sm);
  }

  .section-title__descripcion {
    font-size: var(--texto-lg);
    opacity: 0.8; /* un poco más suave que el título, sirve en fondo claro y oscuro */
  }

  :global(.section--oscura) .section-title__etiqueta {
    color: var(--color-acento);
  }
</style>