---
/* ==========================================================
   HEADER — logo + menú de navegación + botón de contacto
   ========================================================== */
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import logo from "../../assets/images/logo-horizontal.png";
import { sitio, menu } from "../../data/site.js";

// La dirección de la página en la que estamos, ej: "/servicios"
const paginaActual = Astro.url.pathname;

// ¿Este enlace es de la página actual?
const estaActivo = (url:any) => {
  if (url === "/") return paginaActual === "/";
  return paginaActual.startsWith(url);
};
---

<header class="header">
  <div class="container header__contenido">
    <!-- Logo: siempre lleva al inicio -->
    <a href="/" class="header__logo">
      <Image src={logo} alt={sitio.nombre} width={170} loading="eager" class="header__logo-img" />
    </a>

    <!-- Botón hamburguesa (solo en móvil). Funcionará en el Paso 5 -->
    <button
      class="header__boton-menu"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <span class="header__linea"></span>
      <span class="header__linea"></span>
      <span class="header__linea"></span>
    </button>

    <!-- Menú -->
    <nav class="header__nav" id="menu-principal" aria-label="Menú principal">
      <ul class="header__lista">
        {menu.map((enlace) => (
          <li>
            <a
              href={enlace.url}
              class="header__enlace"
              aria-current={estaActivo(enlace.url) ? "page" : undefined}
            >
              {enlace.texto}
            </a>
          </li>
        ))}
      </ul>

      <Button href="/contacto">Contáctanos</Button>
    </nav>
  </div>
</header>

<style>
  /* ---------- Barra fija arriba ---------- */
  .header {
    position: sticky; /* se queda pegado arriba al hacer scroll */
    top: 0;
    z-index: 100; /* por encima del resto del contenido */
    background-color: rgba(247, 249, 255, 0.85);
    backdrop-filter: blur(12px); /* efecto vidrio esmerilado */
    border-bottom: 1px solid var(--color-borde);
  }

  .header__contenido {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .header__logo-img {
    width: 140px;
    height: auto;
  }

  /* ---------- Botón hamburguesa (móvil) ---------- */
  .header__boton-menu {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--espacio-xs);
  }

    .header__linea {
    display: block;
    width: 26px;
    height: 3px;
    border-radius: var(--radio-pildora);
    background-color: var(--color-texto);
    transition:
      transform var(--transicion-rapida),
      opacity var(--transicion-rapida);
  }

  /* Menú abierto: las 3 líneas forman una X */
  .header__boton-menu[aria-expanded="true"] .header__linea:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .header__boton-menu[aria-expanded="true"] .header__linea:nth-child(2) {
    opacity: 0;
  }

  .header__boton-menu[aria-expanded="true"] .header__linea:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* ---------- Menú en móvil: un panel debajo del header ---------- */
  .header__nav {
    display: none; /* oculto hasta que el JS (Paso 5) agregue .is-abierto */
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--espacio-md);
    padding: var(--espacio-md);
    background-color: var(--color-fondo);
    border-bottom: 1px solid var(--color-borde);
    box-shadow: var(--sombra-suave);
  }

  .header__nav.is-abierto {
    display: flex;
  }

  .header__lista {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-sm);
  }

  /* ---------- Enlaces ---------- */
  .header__enlace {
    position: relative;
    font-weight: var(--peso-medio);
    color: var(--color-texto-suave);
    transition: color var(--transicion-rapida);
  }

  .header__enlace:hover,
  .header__enlace[aria-current="page"] {
    color: var(--color-primario);
  }

  /* Rayita con degradado debajo del enlace activo */
  .header__enlace::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 2px;
    background: var(--degradado-marca);
    transition: width var(--transicion-normal);
  }

  .header__enlace:hover::after,
  .header__enlace[aria-current="page"]::after {
    width: 100%;
  }

  /* ---------- Computadora (900px o más) ---------- */
  @media (min-width: 900px) {
    .header__logo-img {
      width: 170px;
    }

    .header__boton-menu {
      display: none; /* ya no se necesita la hamburguesa */
    }

    .header__nav {
      display: flex;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: var(--espacio-lg);
      padding: 0;
      background: none;
      border: none;
      box-shadow: none;
    }

    .header__lista {
      flex-direction: row;
      gap: var(--espacio-lg);
    }
  }
</style>    
<script>
  import "../../scripts/navigation.js";
</script>