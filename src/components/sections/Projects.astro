---
/* ==========================================================
   PROJECTS — tarjetas de proyectos
   - En el Inicio: solo destacados (máx. 3) + botón "Ver todos"
   - En /proyectos: todos, sin botón
   ========================================================== */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SectionTitle from "../ui/SectionTitle.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import isotipo from "../../assets/images/isotipo.png";

const { soloDestacados = false, mostrarBoton = true } = Astro.props;

// 1. Traemos todos los proyectos (un array, como tus productos)
let proyectos = await getCollection("proyectos");

// 2. Los ordenamos del más nuevo al más antiguo
proyectos = proyectos.sort((a: any, b: any) => b.data.fecha - a.data.fecha);

// 3. En el Inicio, solo los destacados y máximo 3
if (soloDestacados) {
  proyectos = proyectos.filter((proyecto: any) => proyecto.data.destacado).slice(0, 3);
}

// Convierte la fecha en texto: "octubre de 2026"
const formatearFecha = (fecha: Date) =>
  fecha.toLocaleDateString("es-PE", { year: "numeric", month: "long" });
---

<section class="section projects">
  <div class="container">
    {soloDestacados && (
      <SectionTitle
        etiqueta="Proyectos"
        titulo="Trabajos que nos enorgullecen"
        descripcion="Algunos proyectos recientes y lo que aprendimos en cada uno."
      />
    )}

    <ul class="projects__lista">
      {proyectos.map((proyecto: any) => (
        <li>
          <a href={`/proyectos/${proyecto.id}`} class="projects__enlace">
            <Card>
              <div class="projects__portada">
                {proyecto.data.portada ? (
                  <Image src={proyecto.data.portada} alt="" width={600} class="projects__imagen" />
                ) : (
                  <Image src={isotipo} alt="" width={120} class="projects__isotipo" />
                )}
              </div>

              <p class="projects__meta">
                <span class="projects__categoria">{proyecto.data.categoria}</span>
                <span>{formatearFecha(proyecto.data.fecha)}</span>
              </p>
              <h3 class="projects__titulo">{proyecto.data.titulo}</h3>
              <p class="projects__descripcion">{proyecto.data.descripcion}</p>
              <span class="projects__leer">Leer proyecto →</span>
            </Card>
          </a>
        </li>
      ))}
    </ul>

    {mostrarBoton && (
      <div class="projects__accion">
        <Button href="/proyectos" variante="secundario">Ver todos los proyectos</Button>
      </div>
    )}
  </div>
</section>

<style>
  .projects__lista {
    display: grid;
    gap: var(--espacio-md);
  }

  @media (min-width: 640px) {
    .projects__lista {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects__lista {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .projects__enlace {
    display: block;
    height: 100%;
  }

  /* ---------- Portada ---------- */
  .projects__portada {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10; /* siempre la misma proporción */
    margin-bottom: var(--espacio-md);
    overflow: hidden;
    border-radius: var(--radio-md);
    background:
      radial-gradient(circle at 30% 30%, rgba(33, 212, 197, 0.25), transparent 60%),
      radial-gradient(circle at 70% 70%, rgba(106, 61, 255, 0.25), transparent 60%),
      var(--color-fondo);
  }

  .projects__imagen {
    width: 100%;
    height: 100%;
    object-fit: cover; /* llena el espacio sin deformarse */
    transition: transform var(--transicion-normal);
  }

  .projects__isotipo {
    width: 80px;
    height: auto;
    transition: transform var(--transicion-normal);
  }

  /* Al pasar el mouse por la tarjeta, la imagen hace zoom */
  .projects__enlace:hover .projects__imagen,
  .projects__enlace:hover .projects__isotipo {
    transform: scale(1.08);
  }

  /* ---------- Texto ---------- */
  .projects__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--espacio-xs);
    margin-bottom: var(--espacio-xs);
    font-size: var(--texto-sm);
    color: var(--color-texto-suave);
  }

  .projects__categoria {
    font-weight: var(--peso-medio);
    color: var(--color-primario);
  }

  .projects__titulo {
    margin-bottom: var(--espacio-xs);
  }

  .projects__descripcion {
    margin-bottom: var(--espacio-md);
    color: var(--color-texto-suave);
  }

  .projects__leer {
    font-weight: var(--peso-medio);
    color: var(--color-primario);
  }

  .projects__accion {
    margin-top: var(--espacio-xl);
    text-align: center;
  }
</style>